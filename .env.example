# 服务端配置。复制为 .env；不要提交真实密钥。
# 默认 .local/workspace；历史参考数据保留在 .local/accord-data。
# ACCORD_DATA_DIR=/absolute/path/to/workspace
ACCORD_LLM_PROVIDER=deepseek
ACCORD_LLM_BASE_URL=https://api.deepseek.com
ACCORD_LLM_API_KEY=
ACCORD_LLM_MODEL=deepseek-v4-pro
# 可选；格式为 model_id|显示名称，多个模型用英文逗号分隔。只在输入框展示这里列出的真实可调用模型。
ACCORD_LLM_MODELS=deepseek-v4-pro|DeepSeek V4 Pro
ACCORD_LLM_REASONING_EFFORT=max
ACCORD_LLM_MAX_TOKENS=65536
ACCORD_LLM_TIMEOUT_SECONDS=900
ACCORD_LLM_DAILY_LIMIT=200
# HTTPS 部署时设置实际站点来源并启用 Secure Cookie。
# ACCORD_PUBLIC_ORIGIN=https://accord.example.com
# ACCORD_COOKIE_SECURE=1
